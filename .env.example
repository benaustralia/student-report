# Copy to .env for `netlify dev`; set the same keys in the Netlify UI for deploys.

# Neon Postgres (create the project in the Sydney region)
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require

# Better Auth — `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Only needed when the site URL cannot be inferred (Netlify sets URL / DEPLOY_PRIME_URL itself)
# BETTER_AUTH_URL=https://nsastudentreports.netlify.app

# Google OAuth client (Web application). Authorised redirect URIs:
#   https://nsastudentreports.netlify.app/api/auth/callback/google
#   https://development--nsastudentreports.netlify.app/api/auth/callback/google
#   http://localhost:8888/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that are admins even before an admin_users row exists (bootstrap)
ADMIN_EMAILS=bahinton@gmail.com

# AI drafting (server-side only now)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- migration only (scripts/migrate-from-firebase.ts) ---
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# FIREBASE_STORAGE_BUCKET=student-reports-final.firebasestorage.app
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=
