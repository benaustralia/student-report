rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin check by email whitelist
    function isAdminByEmailQuery() {
      return request.auth != null && 
        request.auth.token.email in ['bahinton@gmail.com', 'yoc31397@gmail.com', 'wenli11651@gmail.com'];
    }
    
    // Whitelisted users collection - allow bahinton@gmail.com full access during setup
    match /whitelistedUsers/{userId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'bahinton@gmail.com';
    }
    
    // Reports collection - users can only access reports for classes they teach, admins can access all
    match /reports/{reportId} {
      allow read, write: if request.auth != null && (
        request.auth.token.email == resource.data.teacherEmail ||
        isAdminByEmailQuery()
      );
      // Allow creation if user is admin OR if the report's teacherEmail matches a class they teach
      allow create: if request.auth != null && (
        isAdminByEmailQuery() ||
        request.auth.token.email == request.resource.data.teacherEmail
      );
    }
    
    // Classes collection - users can only access their own classes, admins can access all
    match /classes/{classId} {
      allow read: if request.auth != null && (
        request.auth.token.email == resource.data.teacherEmail ||
        isAdminByEmailQuery()
      );
      allow write: if request.auth != null && (
        request.auth.token.email == resource.data.teacherEmail ||
        isAdminByEmailQuery()
      );
      allow create: if request.auth != null && 
        request.auth.token.email == request.resource.data.teacherEmail;
    }
    
    // Students collection - authenticated users can access all students
    match /students/{studentId} {
      allow read, write, delete: if request.auth != null;
    }
    
    // Admin users collection - allow authenticated users to read for admin checks, but only admins can write
    match /adminUsers/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.email == 'bahinton@gmail.com' ||
        isAdminByEmailQuery()
      );
    }
    
    // Teachers collection - authenticated users can read, admins can write
    match /teachers/{teacherId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.email == 'bahinton@gmail.com' ||
        isAdminByEmailQuery()
      );
    }
    
    // Requests collection - teachers can create/read their own requests, admins can read/update all
    match /requests/{requestId} {
      // Teachers can read their own requests, admins can read all
      allow read: if request.auth != null && (
        request.auth.token.email == resource.data.teacherEmail ||
        isAdminByEmailQuery()
      );
      // Teachers can create requests for their own classes, admins can create for any class
      allow create: if request.auth != null && (
        (request.auth.token.email == request.resource.data.teacherEmail) ||
        isAdminByEmailQuery()
      ) && request.resource.data.status == 'pending';
      // Only admins can update (approve/decline) or delete requests
      allow update, delete: if request.auth != null && isAdminByEmailQuery();
    }
  }
}
