rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images can only be accessed by authenticated users
    // Users can only access their own images
    match /images/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && 
        request.auth.uid == userId;
    }
    
    // Allow access to student images for authenticated users
    match /images/students/{studentId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Student reports images
    // Public read for artwork to avoid token/CORS issues; writes require auth
    match /student-reports/students/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Pre-generated PDFs - allow authenticated users to read and write PDFs
match /pdfs/{reportId}/{allPaths=**} {
  allow read, write: if request.auth != null;
}

// Legacy path kept for safety (auth required)
match /student-reports/student/{allPaths=**} {
  allow read, write: if request.auth != null;
}
  }
}
